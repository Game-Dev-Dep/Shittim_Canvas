# 忽略 Unity 默认文件夹
[Bb]uild/
[Bb]uilds/
[Ll]ibrary/
[Ll]ogs/
[Mm]emory[Cc]aptures/
[Oo]bj/
[Tt]emp/
[Uu]ser[Ss]ettings/

# 忽略 Unity 项目文件
*.unityproj

# 忽略 Unity 生成的文件
*.pidb
*.pidb.meta
*.pdb
*.pdb.meta
*.mdb
*.mdb.meta

# 忽略 Unity AddressableAsset 文件
[Ss]erverData/
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/StreamingAssets/aa*

# 忽略 Unity 字体文件夹
/[Aa]ssets/Resources/Fonts/Original_Font

# 忽略 Shittim Canvs 自定义文件夹
RecordVideos/
Screenshots/

# 忽略 Visual Studio 配置文件夹
.vs/

# 忽略 Visual Studio 项目文件
*.csproj
*.sln
*.suo
*.svd
*.user
*.userprefs
*.vsconfig
*.VC.db

# 忽略 Visual Studio Code 配置文件夹
.vscode/

# 忽略 Rider 配置文件夹
.idea/

# 忽略 Jetbrains Rider 自动生成文件夹
/[Aa]ssets/Plugins/Editor/JetBrains*

# 忽略 Jetbrains Rider 配置文件
*.DotSettings.user

# 保留资产 .meta 文件
!*/**/*.meta
/Assets/Editor/Custom Tools
